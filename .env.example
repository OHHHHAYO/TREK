# Copy to .env on the droplet and fill in. NEVER commit the real .env.
#   cp .env.example .env && chmod 600 .env

# ── Required ──────────────────────────────────────────────────────────────────

# Your domain. Caddy requests a certificate for exactly this name, so its DNS
# A record must already point at the droplet before you start the stack.
TREK_DOMAIN=trek.lunabun.app

# Public base URL. Used for OIDC redirects, email notification links and CORS.
APP_URL=https://trek.lunabun.app

# At-rest encryption for stored secrets (API keys, MFA seeds, SMTP, OIDC).
# Generate once with:  openssl rand -hex 32
#
# BACK THIS UP SOMEWHERE OTHER THAN THE DROPLET. A database backup without this
# key leaves every stored secret unreadable.
ENCRYPTION_KEY=

# Where Let's Encrypt sends expiry warnings.
ACME_EMAIL=

# ── First boot only ───────────────────────────────────────────────────────────
# Seeds the first admin account. Ignored once any user exists. Leave both blank
# to have a random password printed to `docker compose logs trek` instead.
# Blank these out after your first login so the password isn't sitting on disk.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Optional ──────────────────────────────────────────────────────────────────

TZ=UTC
LOG_LEVEL=info
DEFAULT_LANGUAGE=en

# Datacenter/VPS IPs are frequently blocked from Unsplash's anonymous endpoint,
# which silently breaks trip-cover and place-image search. Free key at
# https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=

# ── New in 4.3.0 ──────────────────────────────────────────────────────────────

# Place search. Since 4.3.0 TREK asks its own hosted place index
# (https://places.liketrek.com) alongside OpenStreetMap — no key, no quota. It
# is what makes offline place downloads possible, and upstream measures the two
# sources together at a 72.7% top-five hit rate against 50.0% for OSM alone.
#
# Set explicitly rather than left blank so the choice is visible: this decides
# whether searches leave the droplet, and there is deliberately no admin-panel
# switch for it.
#
# What goes out, from the server (never the browser): the words searched, one
# coordinate to rank around, and an opaque per-instance rate-limit token derived
# from APP_URL. No user, account, session, cookie, trip id or language.
# Set to false to search exactly as 4.1.1 did (OpenStreetMap only).
TREK_PLACES_ENABLED=true

# Optional. Base URL of your own copy of the Places API, if you ever run one.
# Read from config rather than user input, so a LAN/Docker address works without
# ALLOW_INTERNAL_NETWORK. Leave blank to use the default above.
#TREK_PLACES_URL=https://places.liketrek.com

# Optional. Your own Nominatim, used for geocoding and for the searches TREK
# still sends to OpenStreetMap. Worth setting if you ever turn the index off,
# since OSM's public service does not permit autocomplete traffic.
#NOMINATIM_URL=

# Optional. Ceiling in ms for one AI-parsing call. Generous by default so large
# documents fit; lower it if you point LLM parsing at a cloud provider and would
# rather fail fast. Must be a whole number 1..2147483647 or the server refuses
# to start. (default: 900000)
#LLM_TIMEOUT_MS=900000

# Optional. Amap (高德地图) key — only relevant for place search inside mainland
# China. AMAP_API_SECRET is required only if the key was created with signing
# enabled. A Web 端 (JS API) key is a different credential and is rejected.
#AMAP_API_KEY=
#AMAP_API_SECRET=

# Stamped into the image at build time. Shows in the admin panel and drives two
# things, so it MUST be valid semver:
#   1. the "update available" banner, which compares it to upstream's latest release
#   2. the plugin compatibility gate — an unparseable value silently disables it
# Build metadata after "+" is legal semver and survives the check, so "5.0.1+fork"
# both identifies this as your build and still compares as 5.0.1.
# Bump this when you merge an upstream release.
APP_VERSION=5.0.1+fork
